{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/indus-open-benchmark/kp1982-layout-proposal.schema.json",
  "title": "Deterministic KP1982 Batch 0 layout proposal",
  "description": "Reproducible cell and context rectangles plus crop commitments generated from a provisional layout seed. This is private review input, not accepted evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "status",
    "scientific_scope",
    "source_contract",
    "layout_seed",
    "page_bitmaps",
    "crop_algorithm",
    "cell_crop_role",
    "context_crop_role",
    "context_padding_basis",
    "context_padding_pixels",
    "cells",
    "assurances"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "manifest_id": {
      "const": "KP1982:BATCH0:LAYOUT-PROPOSAL:V1"
    },
    "status": {
      "const": "private_proposal_only_requires_visual_double_review"
    },
    "scientific_scope": {
      "const": "deterministic crop proposal only; no accepted occupancy, identifier, sign, phonetic, language, semantic, translation, or decipherment inference"
    },
    "source_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256",
        "byte_size"
      ],
      "properties": {
        "id": {
          "const": "KP1982:BATCH0:SOURCE:V1"
        },
        "sha256": {
          "const": "sha256:83ac4be31eb5be146508534df752c7531b5c14caadc20cdd210556644ccc36ab"
        },
        "byte_size": {
          "const": 4029
        }
      }
    },
    "layout_seed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256",
        "byte_size"
      ],
      "properties": {
        "id": {
          "const": "KP1982:BATCH0:LAYOUT-SEED:V1"
        },
        "sha256": {
          "const": "sha256:1254226d13781b67e7c0c52bdeeb01b5327afb9f8b07acadb3e4a4333e72f820"
        },
        "byte_size": {
          "const": 6922
        }
      }
    },
    "page_bitmaps": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "const": {
            "page_index": 19,
            "canonical_pbm_sha256": "sha256:092fa7fc48434e68e71aba57db858db5c82151d12692d6018fa836b66ee992cc"
          }
        },
        {
          "const": {
            "page_index": 20,
            "canonical_pbm_sha256": "sha256:c6313d5e597e723f8d3f9c4118d1aaf5d53a05c22b3dc557a8c2b65178445330"
          }
        }
      ],
      "items": false
    },
    "crop_algorithm": {
      "const": "kp1982-half-pitch-cells-v1"
    },
    "cell_crop_role": {
      "const": "locator_only_may_split_foreground"
    },
    "context_crop_role": {
      "const": "review_view_not_accepted_glyph_evidence"
    },
    "context_padding_basis": {
      "const": "proposal-only 8-connected black=1 component audit with maximum-overlap owner and manifest-order ties; disconnected-mark ownership remains unresolved"
    },
    "context_padding_pixels": {
      "const": 32
    },
    "cells": {
      "type": "array",
      "minItems": 700,
      "maxItems": 700,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/cell"
      }
    },
    "assurances": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_page_pixels_verified",
        "crop_bytes_recomputed",
        "context_component_coverage_recomputed",
        "lane_edges_accepted",
        "row_boundaries_accepted",
        "occupancy_accepted",
        "human_double_review_complete",
        "identifiers_transcribed",
        "decipherment"
      ],
      "properties": {
        "source_page_pixels_verified": {
          "const": true
        },
        "crop_bytes_recomputed": {
          "const": true
        },
        "context_component_coverage_recomputed": {
          "const": false
        },
        "lane_edges_accepted": {
          "const": false
        },
        "row_boundaries_accepted": {
          "const": false
        },
        "occupancy_accepted": {
          "const": false
        },
        "human_double_review_complete": {
          "const": false
        },
        "identifiers_transcribed": {
          "const": false
        },
        "decipherment": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "checksum": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "bbox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 4888
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 6705
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 4888
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 6705
        }
      ],
      "items": false
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell_id",
        "page_index",
        "lane_index",
        "row_index",
        "occupancy_proposal",
        "cell_bbox",
        "context_bbox",
        "cell_crop_sha256",
        "cell_crop_byte_size",
        "context_crop_sha256",
        "context_crop_byte_size",
        "accepted_occupancy"
      ],
      "properties": {
        "cell_id": {
          "type": "string",
          "pattern": "^KP1982:P(?:20|21):L0[0-9]:R(?:0[0-9]|[12][0-9]|3[0-4])$"
        },
        "page_index": {
          "enum": [
            19,
            20
          ]
        },
        "lane_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        },
        "row_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 34
        },
        "occupancy_proposal": {
          "enum": [
            "proposed_occupied",
            "proposed_blank"
          ]
        },
        "cell_bbox": {
          "$ref": "#/$defs/bbox"
        },
        "context_bbox": {
          "$ref": "#/$defs/bbox"
        },
        "cell_crop_sha256": {
          "$ref": "#/$defs/checksum"
        },
        "cell_crop_byte_size": {
          "type": "integer",
          "minimum": 1
        },
        "context_crop_sha256": {
          "$ref": "#/$defs/checksum"
        },
        "context_crop_byte_size": {
          "type": "integer",
          "minimum": 1
        },
        "accepted_occupancy": {
          "type": "null"
        }
      }
    }
  }
}
