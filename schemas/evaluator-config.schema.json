{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evaluator-config.schema.json",
  "title": "Indus Open Benchmark public-development evaluator config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "config_id",
    "claim_class",
    "entrypoint",
    "commands",
    "metrics",
    "random_seeds",
    "network_access_required",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "config_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,159}$"
    },
    "claim_class": {
      "const": "public_development"
    },
    "entrypoint": {
      "type": "string",
      "pattern": "^[a-zA-Z_][a-zA-Z0-9_.]*:[a-zA-Z_][a-zA-Z0-9_]*$"
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "enum": [
          "audit",
          "baseline",
          "null-evaluate",
          "treewidth-audit"
        ]
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
      }
    },
    "random_seeds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483647
      }
    },
    "network_access_required": {
      "const": false
    },
    "notes": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  }
}
