{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "museum-intake.schema.json",
  "title": "Indus Open Benchmark museum API intake record",
  "description": "Rights-cleared staging metadata for an official museum API record and its media. This record is intentionally untranscribed and makes no physical-side, sign, phonetic, linguistic, or translation claims.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "intake_id",
    "record_state",
    "institution",
    "source_id",
    "official_record",
    "retrieval",
    "item_rights",
    "media",
    "catalog_crosswalk",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "intake_id": {
      "$ref": "#/$defs/stable_id"
    },
    "record_state": {
      "const": "untranscribed"
    },
    "institution": {
      "$ref": "#/$defs/institution"
    },
    "source_id": {
      "$ref": "#/$defs/stable_id"
    },
    "official_record": {
      "$ref": "#/$defs/official_record"
    },
    "retrieval": {
      "$ref": "#/$defs/retrieval"
    },
    "item_rights": {
      "$ref": "#/$defs/item_rights"
    },
    "media": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/media"
      }
    },
    "catalog_crosswalk": {
      "$ref": "#/$defs/catalog_crosswalk"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "stable_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "checksum": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "uri": {
      "type": "string",
      "format": "uri"
    },
    "date_time": {
      "type": "string",
      "format": "date-time"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "institution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "institution_id",
        "name"
      ],
      "properties": {
        "institution_id": {
          "$ref": "#/$defs/stable_id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "official_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_id",
        "accession_number",
        "title_as_catalogued",
        "record_uri"
      ],
      "properties": {
        "object_id": {
          "type": "string",
          "minLength": 1
        },
        "accession_number": {
          "type": "string",
          "minLength": 1
        },
        "title_as_catalogued": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "record_uri": {
          "$ref": "#/$defs/uri"
        }
      }
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_endpoint",
        "retrieved_at",
        "http_status",
        "response_content_type",
        "response_sha256",
        "raw_response_local_relative_path"
      ],
      "properties": {
        "api_endpoint": {
          "$ref": "#/$defs/uri"
        },
        "retrieved_at": {
          "$ref": "#/$defs/date_time"
        },
        "http_status": {
          "const": 200
        },
        "response_content_type": {
          "type": "string",
          "pattern": "^application/(?:[A-Za-z0-9.+-]*\\+)?json(?:\\s*;.*)?$"
        },
        "response_sha256": {
          "$ref": "#/$defs/checksum"
        },
        "raw_response_local_relative_path": {
          "$ref": "#/$defs/relative_path"
        }
      }
    },
    "item_rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "item_level_verified",
        "license_id",
        "license_uri",
        "rights_holder",
        "redistribution",
        "derivatives",
        "commercial_use",
        "statement",
        "evidence"
      ],
      "properties": {
        "status": {
          "enum": [
            "public_domain",
            "open_licensed",
            "permission_granted"
          ]
        },
        "item_level_verified": {
          "const": true
        },
        "license_id": {
          "type": "string",
          "minLength": 1
        },
        "license_uri": {
          "$ref": "#/$defs/uri"
        },
        "rights_holder": {
          "type": "string",
          "minLength": 1
        },
        "redistribution": {
          "const": true
        },
        "derivatives": {
          "const": true
        },
        "commercial_use": {
          "const": true
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/$defs/rights_evidence"
        }
      }
    },
    "rights_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "api_field",
        "observed_value",
        "item_record_uri",
        "policy_uri",
        "verified_at",
        "api_response_sha256"
      ],
      "properties": {
        "scope": {
          "const": "item"
        },
        "api_field": {
          "type": "string",
          "minLength": 1
        },
        "observed_value": {
          "type": [
            "string",
            "boolean"
          ]
        },
        "item_record_uri": {
          "$ref": "#/$defs/uri"
        },
        "policy_uri": {
          "$ref": "#/$defs/uri"
        },
        "verified_at": {
          "$ref": "#/$defs/date_time"
        },
        "api_response_sha256": {
          "$ref": "#/$defs/checksum"
        }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "media_id",
        "provider_media_id",
        "provider_view_index",
        "provider_derivative",
        "provider_width",
        "provider_height",
        "api_declared_bytes",
        "view_role",
        "physical_side",
        "source_uri",
        "rights_basis",
        "download"
      ],
      "properties": {
        "media_id": {
          "$ref": "#/$defs/stable_id"
        },
        "provider_media_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "provider_view_index": {
          "type": "integer",
          "minimum": 0
        },
        "provider_derivative": {
          "enum": [
            "met_original",
            "cleveland_print",
            "cleveland_full",
            "provider_original",
            "provider_other",
            "unknown"
          ]
        },
        "provider_width": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "provider_height": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "api_declared_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "view_role": {
          "enum": [
            "provider_primary",
            "provider_alternate_unknown",
            "provider_detail_unknown",
            "provider_unspecified"
          ]
        },
        "physical_side": {
          "const": "unknown"
        },
        "source_uri": {
          "$ref": "#/$defs/uri"
        },
        "rights_basis": {
          "const": "item_rights"
        },
        "download": {
          "$ref": "#/$defs/download"
        }
      }
    },
    "download": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "sha256",
        "bytes",
        "content_type",
        "local_relative_path",
        "downloaded_at"
      ],
      "properties": {
        "status": {
          "enum": [
            "downloaded",
            "not_downloaded"
          ]
        },
        "sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/checksum"
            },
            {
              "type": "null"
            }
          ]
        },
        "bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "content_type": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^image/[A-Za-z0-9.+-]+(?:\\s*;.*)?$"
        },
        "local_relative_path": {
          "oneOf": [
            {
              "$ref": "#/$defs/relative_path"
            },
            {
              "type": "null"
            }
          ]
        },
        "downloaded_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/date_time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "downloaded"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "sha256": {
                "$ref": "#/$defs/checksum"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1
              },
              "content_type": {
                "type": "string",
                "pattern": "^image/[A-Za-z0-9.+-]+(?:\\s*;.*)?$"
              },
              "local_relative_path": {
                "$ref": "#/$defs/relative_path"
              },
              "downloaded_at": {
                "$ref": "#/$defs/date_time"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_downloaded"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "sha256": {
                "type": "null"
              },
              "bytes": {
                "type": "null"
              },
              "content_type": {
                "type": "null"
              },
              "local_relative_path": {
                "type": "null"
              },
              "downloaded_at": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "catalog_crosswalk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "notes"
      ],
      "properties": {
        "status": {
          "const": "unresolved"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    }
  }
}
