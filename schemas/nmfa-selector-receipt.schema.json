{
  "$defs": {
    "checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "opaque_id": {
      "pattern": "^hmac-sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "registry_id": {
      "pattern": "^registry-id:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$id": "https://example.org/indus-open-benchmark/schemas/nmfa-selector-receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assignments": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "cell": {
            "oneOf": [
              {
                "enum": [
                  "site",
                  "period",
                  "medium",
                  "object_type"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "g_id": {
            "$ref": "#/$defs/checksum"
          },
          "partition": {
            "enum": [
              "development",
              "holdout",
              "validation"
            ],
            "type": "string"
          },
          "primary_f_id": {
            "$ref": "#/$defs/opaque_id"
          }
        },
        "required": [
          "cell",
          "g_id",
          "partition",
          "primary_f_id"
        ],
        "type": "object"
      },
      "maxItems": 20000,
      "minItems": 160,
      "type": "array"
    },
    "assurance_boundary": {
      "additionalProperties": false,
      "properties": {
        "claim_binding_origin_verified": {
          "const": false,
          "type": "boolean"
        },
        "eligible_inventory_digest_origin_verified": {
          "const": false,
          "type": "boolean"
        },
        "external_nonce_provenance_verified": {
          "const": false,
          "type": "boolean"
        },
        "one_use_consumption_verified": {
          "const": false,
          "type": "boolean"
        },
        "realized_split": {
          "const": false,
          "type": "boolean"
        },
        "relation_evidence_origin_verified": {
          "const": false,
          "type": "boolean"
        },
        "scientific_result": {
          "const": false,
          "type": "boolean"
        },
        "value_free_identifier_origin_verified": {
          "const": false,
          "type": "boolean"
        }
      },
      "required": [
        "claim_binding_origin_verified",
        "eligible_inventory_digest_origin_verified",
        "external_nonce_provenance_verified",
        "one_use_consumption_verified",
        "realized_split",
        "relation_evidence_origin_verified",
        "scientific_result",
        "value_free_identifier_origin_verified"
      ],
      "type": "object"
    },
    "bindings": {
      "additionalProperties": false,
      "properties": {
        "eligible_split_inventory_sha256": {
          "$ref": "#/$defs/checksum"
        },
        "gate_evaluator_bundle_sha256": {
          "const": "sha256:ec9ba6fbaa5df13dce438f819114206da2d6ca6e68afb521476635d5abd91a79",
          "type": "string"
        },
        "gate_plan_sha256": {
          "const": "sha256:dfea30b6cc0635e98d6fc1c0125e428df454bfbb4f22ba464923801db01273af",
          "type": "string"
        },
        "parent_protocol_sha256": {
          "const": "sha256:b4e175ee3506a8f46883428937236bc5353f26bbe32db64ad98d72eca4692307",
          "type": "string"
        },
        "selector_bundle_sha256": {
          "$ref": "#/$defs/checksum"
        },
        "selector_inventory_sha256": {
          "$ref": "#/$defs/checksum"
        },
        "selector_plan_sha256": {
          "const": "sha256:f4c80a15804c4dffcef4f850d597f54836b44c3444af811f1c686814f39c5190",
          "type": "string"
        },
        "tuple_roster_sha256": {
          "$ref": "#/$defs/checksum"
        }
      },
      "required": [
        "eligible_split_inventory_sha256",
        "gate_evaluator_bundle_sha256",
        "gate_plan_sha256",
        "parent_protocol_sha256",
        "selector_bundle_sha256",
        "selector_inventory_sha256",
        "selector_plan_sha256",
        "tuple_roster_sha256"
      ],
      "type": "object"
    },
    "claim_binding": {
      "additionalProperties": false,
      "properties": {
        "claim_family_id": {
          "$ref": "#/$defs/registry_id"
        },
        "claim_slot_id": {
          "$ref": "#/$defs/registry_id"
        },
        "experiment_instance_id": {
          "$ref": "#/$defs/registry_id"
        },
        "predecessor_chain_head_sha256": {
          "$ref": "#/$defs/checksum"
        }
      },
      "required": [
        "claim_family_id",
        "claim_slot_id",
        "experiment_instance_id",
        "predecessor_chain_head_sha256"
      ],
      "type": "object"
    },
    "compiled_blockers": {
      "const": [
        "CLAIM_BINDING_ORIGIN_UNBOUND",
        "COMPLETE_RELATION_CLOSURE_UNBOUND",
        "EXTERNAL_ELIGIBLE_INVENTORY_DIGEST_ORIGIN_UNBOUND",
        "VALUE_FREE_IDENTIFIER_ORIGIN_UNBOUND",
        "NONCE_EVENT_TRUST_UNBOUND",
        "ONE_USE_CONSUMPTION_UNBOUND",
        "TYPED_X_MODEL_UNBOUND",
        "TYPED_Y_METRICS_UNBOUND",
        "N1_N2_RUNNER_UNBOUND",
        "PROSPECTIVE_EVALUATOR_UNBOUND",
        "TERMINAL_ORCHESTRATOR_UNBOUND",
        "ACTIVATION_WRAPPER_UNBOUND",
        "COMPLETE_EXECUTION_BUNDLE_UNBOUND"
      ],
      "type": "array"
    },
    "format_version": {
      "const": "1.0.0",
      "type": "string"
    },
    "n2_movable_g": {
      "maximum": 20000,
      "minimum": 64,
      "type": "integer"
    },
    "nonce_sha256": {
      "$ref": "#/$defs/checksum"
    },
    "record_kind": {
      "const": "nmfa_protected_selector_assignment",
      "type": "string"
    },
    "selected_ticket_sha256": {
      "$ref": "#/$defs/checksum"
    },
    "selected_tuple": {
      "items": {
        "$ref": "#/$defs/opaque_id"
      },
      "maxItems": 4,
      "minItems": 4,
      "type": "array"
    },
    "split_eligible_tuple_count": {
      "maximum": 10000,
      "minimum": 1,
      "type": "integer"
    },
    "terminal_state": {
      "const": "DECLARED_SELECTOR_ASSIGNMENT_ONLY",
      "type": "string"
    }
  },
  "required": [
    "assignments",
    "assurance_boundary",
    "bindings",
    "claim_binding",
    "compiled_blockers",
    "format_version",
    "n2_movable_g",
    "nonce_sha256",
    "record_kind",
    "selected_ticket_sha256",
    "selected_tuple",
    "split_eligible_tuple_count",
    "terminal_state"
  ],
  "title": "NMFA protected declared selector assignment",
  "type": "object"
}
