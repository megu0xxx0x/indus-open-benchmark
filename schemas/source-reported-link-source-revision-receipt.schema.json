{
  "$comment": "Static closed-shape schema only. It creates no source-access authority and performs no acquisition. retrieved_at is an untrusted local observation in exact UTC RFC3339 whole-second Z lexical form. ETag and Last-Modified are absent-as-null; if present, exactly one header occurrence is required, surrounding ASCII OWS is removed, multiple occurrences or CR/LF/U+2028/U+2029 are hard rejects, and ETag weak tags are preserved. Last-Modified validation here is IMF-fixdate-shaped lexical validation only; calendar validity and weekday agreement require the future strict verifier and schema validity alone makes no such claim. Each byte_size and sha256 must be recomputed from the exact identity-layer body before receipt creation; schema validity cannot substitute for that comparison. The receipt payload must not contain revision_receipt_sha256; that digest is carried only by the separate commitment envelope.",
  "$defs": {
    "etag": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "maxLength": 1024,
          "minLength": 2,
          "not": {
            "pattern": "[\\r\\n\\u2028\\u2029]"
          },
          "pattern": "^(?:W/)?\"[!#-~]*\"$",
          "type": "string"
        }
      ]
    },
    "lastModified": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "maxLength": 29,
          "minLength": 29,
          "pattern": "^(?:Mon|Tue|Wed|Thu|Fri|Sat|Sun), (?:0[1-9]|[12][0-9]|3[01]) (?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec) [0-9]{4} (?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9] GMT$",
          "type": "string"
        }
      ]
    },
    "member": {
      "additionalProperties": false,
      "properties": {
        "byte_size": {
          "maximum": 10485760,
          "minimum": 1,
          "type": "integer"
        },
        "content_encoding": {
          "const": "identity"
        },
        "content_type": {
          "const": "text/html"
        },
        "etag": {
          "$ref": "#/$defs/etag"
        },
        "final_uri": {
          "type": "string"
        },
        "http_status": {
          "const": 200
        },
        "last_modified": {
          "$ref": "#/$defs/lastModified"
        },
        "redirect_chain": {
          "const": []
        },
        "requested_uri": {
          "type": "string"
        },
        "resource_id": {
          "type": "string"
        },
        "response_representation": {
          "const": "exact_http_response_body_after_transfer_decoding_before_text_decoding"
        },
        "retrieved_at": {
          "format": "date-time",
          "maxLength": 20,
          "minLength": 20,
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$",
          "type": "string"
        },
        "sha256": {
          "maxLength": 71,
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "resource_id",
        "requested_uri",
        "final_uri",
        "redirect_chain",
        "retrieved_at",
        "http_status",
        "content_type",
        "content_encoding",
        "response_representation",
        "byte_size",
        "sha256",
        "etag",
        "last_modified"
      ],
      "type": "object"
    }
  },
