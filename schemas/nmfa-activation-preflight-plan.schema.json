{
  "$defs": {
    "asset": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "bytes",
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "sha256_or_null": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "timestamp": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    }
  },
  "$id": "nmfa-activation-preflight-plan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assurance_boundary": {
      "additionalProperties": false,
      "properties": {
        "candidate_or_tofu_trust_forbidden": {
          "const": true
        },
        "decipherment_claim_allowed": {
          "const": false
        },
        "evaluator_holds_private_keys": {
          "const": false
        },
        "execution_authorized": {
          "const": false
        },
        "external_independence_proven": {
          "const": false
        },
        "metadata_byte_channel_verified": {
          "const": false
        },
        "opaque_identifier_origin_verified": {
          "const": false
        },
        "private_reports_only": {
          "const": true
        },
        "prize_submission_eligible": {
          "const": false
        },
        "protected_source_accessed_by_installed_evaluator": {
          "const": false
        },
        "public_summary_allowed": {
          "const": false
        }
      },
      "required": [
        "candidate_or_tofu_trust_forbidden",
        "decipherment_claim_allowed",
        "evaluator_holds_private_keys",
        "execution_authorized",
        "external_independence_proven",
        "metadata_byte_channel_verified",
        "opaque_identifier_origin_verified",
        "private_reports_only",
        "protected_source_accessed_by_installed_evaluator",
        "prize_submission_eligible",
        "public_summary_allowed"
      ],
      "type": "object"
    },
    "bound_assets": {
      "additionalProperties": false,
      "properties": {
        "parent_protocol": {
          "$ref": "#/$defs/asset"
        },
        "preregistration_evaluator_bundle": {
          "$ref": "#/$defs/asset"
        },
        "preregistration_gate_plan": {
          "$ref": "#/$defs/asset"
        }
      },
      "required": [
        "parent_protocol",
        "preregistration_evaluator_bundle",
        "preregistration_gate_plan"
      ],
      "type": "object"
    },
    "canonicalization": {
      "additionalProperties": false,
      "properties": {
        "encoding": {
          "const": "UTF-8_without_BOM_LF_terminated"
        },
        "floats": {
          "const": "forbidden"
        },
        "integer_range": {
          "const": "signed_64_bit"
        },
        "profile": {
          "const": "indusbench-canonical-json-sort-keys-indent-2-v1"
        }
      },
      "required": [
        "encoding",
        "floats",
        "integer_range",
        "profile"
      ],
      "type": "object"
    },
    "chronology": {
      "items": {
        "enum": [
          "source_free_bundles_frozen",
          "claim_slot_reserved",
          "identifier_key_ceremony_completed",
          "PREMETADATA_evaluator_package_verified",
          "PREMETADATA_READY_registry_consumed",
          "first_metadata_access",
          "declared_inventory_frozen",
          "both_value_layers_PREPARED_LOCKED",
          "prevalue_request_subject_frozen",
          "prevalue_request_signatures_collected",
          "PREVALUE_evaluator_package_verified",
          "PREVALUE_READY_registry_consumed",
          "both_value_layers_ARMED_NOT_RELEASED_via_CAS",
          "first_transcription_or_target_access"
        ]
      },
      "maxItems": 14,
      "minItems": 14,
      "type": "array",
      "uniqueItems": true
    },
    "compiled_blockers": {
      "additionalProperties": false,
      "properties": {
        "activation_wrapper_sha256": {
          "$ref": "#/$defs/sha256_or_null"
        },
        "consumption_registry_profile_sha256": {
          "$ref": "#/$defs/sha256_or_null"
        },
        "external_time_anchor_profile_sha256": {
          "$ref": "#/$defs/sha256_or_null"
        },
        "external_trust_profile_sha256": {
          "$ref": "#/$defs/sha256_or_null"
        },
        "typed_execution_bundle_sha256": {
          "$ref": "#/$defs/sha256_or_null"
        }
      },
      "required": [
        "activation_wrapper_sha256",
        "consumption_registry_profile_sha256",
        "external_time_anchor_profile_sha256",
        "external_trust_profile_sha256",
        "typed_execution_bundle_sha256"
      ],
      "type": "object"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "cryptography": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "canonical_base64url_without_padding": {
          "const": true
        },
        "key_id_rule": {
          "const": "ed25519_colon_sha256_raw_public_key"
        },
        "public_key_bytes": {
          "const": 32
        },
        "reject_noncanonical_R": {
          "const": true
        },
        "reject_noncanonical_S": {
          "const": true
        },
        "require_nonidentity_prime_subgroup_public_key_and_R": {
          "const": true
        },
        "signature_bytes": {
          "const": 64
        }
      },
      "required": [
        "algorithm",
        "canonical_base64url_without_padding",
        "key_id_rule",
        "public_key_bytes",
        "require_nonidentity_prime_subgroup_public_key_and_R",
        "reject_noncanonical_R",
        "reject_noncanonical_S",
        "signature_bytes"
      ],
      "type": "object"
    },
    "decision": {
      "additionalProperties": false,
      "properties": {
        "premetadata_blocked": {
          "const": "PREMETADATA_BLOCKED"
        },
        "premetadata_ready": {
          "const": "PREMETADATA_READY"
        },
        "prevalue_blocked": {
          "const": "PREVALUE_BLOCKED"
        },
        "prevalue_ready": {
          "const": "PREVALUE_READY"
        },
        "ready_requires_empty_reason_codes": {
          "const": true
        }
      },
      "required": [
        "premetadata_blocked",
        "premetadata_ready",
        "prevalue_blocked",
        "prevalue_ready",
        "ready_requires_empty_reason_codes"
      ],
      "type": "object"
    },
    "digest_dag": {
      "items": {
        "enum": [
          "required_future_E_typed_execution_core_bundle",
          "required_future_P_preflight_evaluator_bundle_binds_E_and_V1",
          "required_future_A_activation_root_binds_E_P_and_V1",
          "claim_reservation_binds_A",
          "identifier_ceremony_binds_claim",
          "PREMETADATA_binds_claim_identifier_and_zero_access_head",
          "PREVALUE_binds_PREMETADATA_inventory_barriers_and_access_head",
          "first_value_access_binds_verified_PREVALUE_composite"
        ]
      },
      "maxItems": 8,
      "minItems": 8,
      "type": "array",
      "uniqueItems": true
    },
    "digest_dag_status": {
      "const": "FUTURE_REQUIRED_NOT_INSTALLED"
    },
    "format_version": {
      "const": "1.0.0"
    },
    "installed_semantic_scope": {
      "additionalProperties": false,
      "properties": {
        "authority_and_rights_evidence": {
          "const": "SIGNED_DECLARATIONS_AND_OPAQUE_COMMITMENTS_ONLY"
        },
        "expected_trust_digest_origin": {
          "const": "CALLER_SUPPLIED_NOT_AUTHENTICATED"
        },
        "inventory_universe": {
          "const": "DECLARED_ROSTER_CONSISTENCY_ONLY_EXTERNAL_COMPLETENESS_NOT_VERIFIED"
        },
        "ledger_prefix": {
          "const": "AGGREGATE_HEAD_DECLARATION_ONLY"
        },
        "metadata_channel": {
          "const": "POLICY_REQUIREMENTS_ONLY_PROVIDER_BYTES_NOT_VERIFIED"
        },
        "opaque_identifier_origin": {
          "const": "SYNTAX_ONLY_NOT_VERIFIED"
        },
        "prize_submission": {
          "const": "OUTSIDE_PREFLIGHT_NOT_EVALUATED"
        },
        "r0_completeness": {
          "const": "DEFERRED_TO_TYPED_EXECUTION_BUNDLE_AND_ACTIVATION_WRAPPER"
        },
        "relation_edges": {
          "const": "DECLARED_SET_STRUCTURE_ONLY"
        },
        "rpre_closure": {
          "const": "DEFERRED_TO_TYPED_EXECUTION_BUNDLE_AND_ACTIVATION_WRAPPER"
        },
        "value_surface": {
          "const": "CLOSED_NAMED_TYPED_FIELDS_ONLY_NO_PROVENANCE_PROOF"
        }
      },
      "required": [
        "authority_and_rights_evidence",
        "expected_trust_digest_origin",
        "inventory_universe",
        "ledger_prefix",
        "metadata_channel",
        "opaque_identifier_origin",
        "prize_submission",
        "r0_completeness",
        "relation_edges",
        "rpre_closure",
        "value_surface"
      ],
      "type": "object"
    },
    "limits": {
      "additionalProperties": false,
      "properties": {
        "max_inventory_rows": {
          "minimum": 1,
          "type": "integer"
        },
        "max_json_bytes": {
          "minimum": 1024,
          "type": "integer"
        },
        "max_json_depth": {
          "minimum": 8,
          "type": "integer"
        },
        "max_json_nodes": {
          "minimum": 100,
          "type": "integer"
        },
        "max_string_length": {
          "minimum": 64,
          "type": "integer"
        }
      },
      "required": [
        "max_inventory_rows",
        "max_json_bytes",
        "max_json_depth",
        "max_json_nodes",
        "max_string_length"
      ],
      "type": "object"
    },
    "plan_id": {
      "const": "nmfa-activation-preflight-plan-v1"
    },
    "role_policy": {
      "additionalProperties": false,
      "properties": {
        "all_actor_controller_and_conflict_domains_distinct": {
          "const": true
        },
        "premetadata_signature_roles": {
          "const": [
            "authority",
            "governance_reviewer",
            "metadata_controller"
          ]
        },
        "prevalue_signature_roles": {
          "const": [
            "authority",
            "governance_reviewer",
            "metadata_controller",
            "target_controller",
            "transcription_controller",
            "value_barrier_coordinator"
          ]
        },
        "structural_separation_is_not_real_world_independence_proof": {
          "const": true
        }
      },
      "required": [
        "all_actor_controller_and_conflict_domains_distinct",
        "premetadata_signature_roles",
        "prevalue_signature_roles",
        "structural_separation_is_not_real_world_independence_proof"
      ],
      "type": "object"
    },
    "value_surface_policy": {
      "additionalProperties": false,
      "properties": {
        "actual_archive_material_has_no_typed_surface_prevalue": {
          "const": true
        },
        "eligible_or_final_g_has_no_typed_input_prevalue": {
          "const": true
        },
        "free_text_and_urls_have_no_typed_surface": {
          "const": true
        },
        "mixed_byte_channel_rejection_requires_external_wrapper": {
          "const": true
        },
        "opaque_identifier_origin_not_proven_by_syntax": {
          "const": true
        },
        "predictions_scores_and_value_digests_have_no_typed_surface_prevalue": {
          "const": true
        },
        "target_or_transcription_status_has_no_typed_surface_prevalue": {
          "const": true
        }
      },
      "required": [
        "actual_archive_material_has_no_typed_surface_prevalue",
        "eligible_or_final_g_has_no_typed_input_prevalue",
        "free_text_and_urls_have_no_typed_surface",
        "mixed_byte_channel_rejection_requires_external_wrapper",
        "opaque_identifier_origin_not_proven_by_syntax",
        "predictions_scores_and_value_digests_have_no_typed_surface_prevalue",
        "target_or_transcription_status_has_no_typed_surface_prevalue"
      ],
      "type": "object"
    }
  },
  "required": [
    "assurance_boundary",
    "bound_assets",
    "canonicalization",
    "chronology",
    "compiled_blockers",
    "created_at",
    "cryptography",
    "decision",
    "digest_dag",
    "digest_dag_status",
    "format_version",
    "installed_semantic_scope",
    "limits",
    "plan_id",
    "role_policy",
    "value_surface_policy"
  ],
  "type": "object"
}
