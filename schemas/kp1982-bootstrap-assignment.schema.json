{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/indus-open-benchmark/kp1982-bootstrap-assignment.schema.json",
  "title": "Proposal-value-stripped KP1982 Batch 0 sign-inventory bootstrap assignment",
  "description": "A closed private assignment derived from exact source, layout-seed, layout-proposal, and page-bitmap commitments. It exposes only proposed crop locators and reviewer context views; schema validity alone does not establish geometry, blindness, reviewer independence, sign identity, or scientific acceptance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "status",
    "scientific_scope",
    "source_contract",
    "layout_seed",
    "layout_proposal",
    "page_bitmaps",
    "crop_policy",
    "withheld_fields",
    "cells",
    "assurances"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "manifest_id": {
      "const": "KP1982:BATCH0:BOOTSTRAP-ASSIGNMENT:V1"
    },
    "status": {
      "const": "private_proposal_value_stripped_bootstrap_assignment_only_requires_independent_human_review"
    },
    "scientific_scope": {
      "const": "proposal-value-stripped sign-inventory bootstrap assignment only; proposed crop rectangles are review aids, machine occupancy/OCR/identifier values are withheld, and no accepted observation, sign identity, phonetic, language, semantic, translation, or decipherment inference is present"
    },
    "source_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256",
        "byte_size"
      ],
      "properties": {
        "id": {
          "const": "KP1982:BATCH0:SOURCE:V1"
        },
        "sha256": {
          "const": "sha256:83ac4be31eb5be146508534df752c7531b5c14caadc20cdd210556644ccc36ab"
        },
        "byte_size": {
          "const": 4029
        }
      }
    },
    "layout_seed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256",
        "byte_size"
      ],
      "properties": {
        "id": {
          "const": "KP1982:BATCH0:LAYOUT-SEED:V1"
        },
        "sha256": {
          "const": "sha256:1254226d13781b67e7c0c52bdeeb01b5327afb9f8b07acadb3e4a4333e72f820"
        },
        "byte_size": {
          "const": 6922
        }
      }
    },
    "layout_proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256",
        "byte_size"
      ],
      "properties": {
        "id": {
          "const": "KP1982:BATCH0:LAYOUT-PROPOSAL:V1"
        },
        "sha256": {
          "const": "sha256:85dfa34210380ca6f92fa2847d50050642bc221910a05eb2fed33855f3894a78"
        },
        "byte_size": {
          "const": 460008
        }
      }
    },
    "page_bitmaps": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "const": {
            "page_index": 19,
            "canonical_pbm_sha256": "sha256:092fa7fc48434e68e71aba57db858db5c82151d12692d6018fa836b66ee992cc",
            "byte_size": 4096768
          }
        },
        {
          "const": {
            "page_index": 20,
            "canonical_pbm_sha256": "sha256:c6313d5e597e723f8d3f9c4118d1aaf5d53a05c22b3dc557a8c2b65178445330",
            "byte_size": 4096768
          }
        }
      ],
      "items": false
    },
    "crop_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "coordinate_space",
        "origin",
        "rectangle_encoding",
        "canonical_crop_encoding",
        "cell_crop_role",
        "context_crop_role",
        "context_padding_pixels",
        "bbox_status"
      ],
      "properties": {
        "algorithm": {
          "const": "kp1982-half-pitch-cells-v1"
        },
        "coordinate_space": {
          "const": "decoded_embedded_page_image_pixels"
        },
        "origin": {
          "const": "top_left"
        },
        "rectangle_encoding": {
          "const": "half_open_xyxy_integer"
        },
        "canonical_crop_encoding": {
          "const": "P4 with exact dimensions; row-major top-to-bottom, left-to-right, black=1, MSB-first, zero unused low bits"
        },
        "cell_crop_role": {
          "const": "locator_only_may_split_foreground"
        },
        "context_crop_role": {
          "const": "review_view_not_accepted_glyph_evidence"
        },
        "context_padding_pixels": {
          "const": 32
        },
        "bbox_status": {
          "const": "proposal_only_requires_independent_visual_acceptance"
        }
      }
    },
    "withheld_fields": {
      "const": [
        "layout_proposal.cells[].occupancy_proposal",
        "layout_proposal.cells[].accepted_occupancy",
        "all_ocr_output",
        "all_machine_identifier_proposals",
        "all_accepted_observation_fields"
      ]
    },
    "cells": {
      "type": "array",
      "minItems": 700,
      "maxItems": 700,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/cell"
      }
    },
    "assurances": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_contract_exact_bytes_verified",
        "layout_seed_exact_bytes_verified",
        "layout_proposal_exact_bytes_verified",
        "canonical_page_bitmaps_verified",
        "cell_geometry_accepted",
        "occupancy_accepted",
        "human_review_complete",
        "reviewer_independence_verified",
        "reviewer_blinding_verified",
        "identifiers_transcribed",
        "private_storage_verified",
        "public_release_authorized",
        "evaluation_admissible",
        "decipherment"
      ],
      "properties": {
        "source_contract_exact_bytes_verified": {
          "const": true
        },
        "layout_seed_exact_bytes_verified": {
          "const": true
        },
        "layout_proposal_exact_bytes_verified": {
          "const": true
        },
        "canonical_page_bitmaps_verified": {
          "const": true
        },
        "cell_geometry_accepted": {
          "const": false
        },
        "occupancy_accepted": {
          "const": false
        },
        "human_review_complete": {
          "const": false
        },
        "reviewer_independence_verified": {
          "const": false
        },
        "reviewer_blinding_verified": {
          "const": false
        },
        "identifiers_transcribed": {
          "const": false
        },
        "private_storage_verified": {
          "const": false
        },
        "public_release_authorized": {
          "const": false
        },
        "evaluation_admissible": {
          "const": false
        },
        "decipherment": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "checksum": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "bbox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 4888
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 6705
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 4888
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 6705
        }
      ],
      "items": false
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell_id",
        "page_index",
        "lane_index",
        "row_index",
        "proposed_cell_bbox",
        "proposed_context_bbox",
        "cell_crop_sha256",
        "cell_crop_byte_size",
        "context_crop_sha256",
        "context_crop_byte_size"
      ],
      "properties": {
        "cell_id": {
          "type": "string",
          "pattern": "^KP1982:P(?:20|21):L0[0-9]:R(?:0[0-9]|[12][0-9]|3[0-4])$"
        },
        "page_index": {
          "enum": [
            19,
            20
          ]
        },
        "lane_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        },
        "row_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 34
        },
        "proposed_cell_bbox": {
          "$ref": "#/$defs/bbox"
        },
        "proposed_context_bbox": {
          "$ref": "#/$defs/bbox"
        },
        "cell_crop_sha256": {
          "$ref": "#/$defs/checksum"
        },
        "cell_crop_byte_size": {
          "type": "integer",
          "minimum": 1
        },
        "context_crop_sha256": {
          "$ref": "#/$defs/checksum"
        },
        "context_crop_byte_size": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
