{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "penn-metadata-snapshot.schema.json",
  "title": "Penn Museum metadata-only CSV snapshot candidates",
  "description": "A closed, image-free derivation of review candidates from exact Penn Museum CSV bytes. Candidate status is not a transcription, translation, or originality claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "record_state",
    "source",
    "source_acquisition",
    "csv_header",
    "record_count",
    "candidate_count",
    "candidates",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^penn-museum-csv:sha256:[0-9a-f]{64}$"
    },
    "record_state": {
      "const": "metadata_only_untranscribed"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "source_acquisition": {
      "$ref": "#/$defs/source_acquisition"
    },
    "csv_header": {
      "const": [
        "Record URL",
        "identifier",
        "curatorialSection",
        "onDisplay",
        "objectName",
        "nativeName",
        "title",
        "creditLine",
        "description",
        "placeName",
        "siteName",
        "culture",
        "cultureArea",
        "locus",
        "period",
        "material",
        "technique",
        "creator",
        "iconography",
        "iconographySubject",
        "inscriptionMarkLanguage",
        "dateMade",
        "earlyDate",
        "lateDate",
        "depth",
        "length",
        "width",
        "height",
        "thickness",
        "weight",
        "outsideDiameter",
        "measurementUnit"
      ]
    },
    "record_count": {
      "type": "integer",
      "minimum": 0
    },
    "candidate_count": {
      "type": "integer",
      "minimum": 0
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "limitations": {
      "const": [
        "metadata_only_no_images",
        "candidate_classification_requires_human_review",
        "physical_status_never_auto_labels_original"
      ]
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "institution_id",
        "institution_name",
        "dataset_url",
        "landing_url",
        "terms_url",
        "license_id",
        "license_url",
        "attribution",
        "images_included"
      ],
      "properties": {
        "institution_id": {
          "const": "penn-museum"
        },
        "institution_name": {
          "const": "Penn Museum"
        },
        "dataset_url": {
          "const": "https://collections.penn.museum/collections/assets/data/Penn_Museum_Collections_Data.csv"
        },
        "landing_url": {
          "const": "https://collections.penn.museum/collections/objects/data.php"
        },
        "terms_url": {
          "const": "https://www.penn.museum/about/statements-and-policies/terms-and-conditions"
        },
        "license_id": {
          "const": "CC-BY-4.0"
        },
        "license_url": {
          "const": "https://creativecommons.org/licenses/by/4.0/"
        },
        "attribution": {
          "const": "Penn Museum"
        },
        "images_included": {
          "const": false
        }
      }
    },
    "source_acquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "retrieved_at",
        "bytes",
        "sha256",
        "etag",
        "last_modified",
        "source_last_updated"
      ],
      "properties": {
        "url": {
          "const": "https://collections.penn.museum/collections/assets/data/Penn_Museum_Collections_Data.csv"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "etag": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "last_modified": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "source_last_updated": {
          "oneOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "csv_row_number",
        "classification",
        "matches",
        "record_url",
        "identifier",
        "physical_status",
        "raw_fields"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "pattern": "^penn-museum-candidate:sha256:[0-9a-f]{64}$"
        },
        "csv_row_number": {
          "type": "integer",
          "minimum": 2
        },
        "classification": {
          "enum": [
            "primary_script_candidate",
            "broad_archaeological_candidate"
          ]
        },
        "matches": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/candidate_match"
          }
        },
        "record_url": {
          "type": "string",
          "minLength": 1
        },
        "identifier": {
          "type": "string",
          "minLength": 1
        },
        "physical_status": {
          "enum": [
            "replica_or_modern",
            "physical_status_unknown_pending_review"
          ]
        },
        "raw_fields": {
          "$ref": "#/$defs/raw_fields"
        }
      }
    },
    "candidate_match": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "normalized_token"
      ],
      "properties": {
        "field": {
          "enum": [
            "inscriptionMarkLanguage",
            "culture"
          ]
        },
        "normalized_token": {
          "enum": [
            "indus script",
            "harappan"
          ]
        }
      }
    },
    "raw_fields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Record URL",
        "identifier",
        "curatorialSection",
        "onDisplay",
        "objectName",
        "nativeName",
        "title",
        "creditLine",
        "description",
        "placeName",
        "siteName",
        "culture",
        "cultureArea",
        "locus",
        "period",
        "material",
        "technique",
        "creator",
        "iconography",
        "iconographySubject",
        "inscriptionMarkLanguage",
        "dateMade",
        "earlyDate",
        "lateDate",
        "depth",
        "length",
        "width",
        "height",
        "thickness",
        "weight",
        "outsideDiameter",
        "measurementUnit"
      ],
      "properties": {
        "Record URL": {
          "type": "string"
        },
        "identifier": {
          "type": "string"
        },
        "curatorialSection": {
          "type": "string"
        },
        "onDisplay": {
          "type": "string"
        },
        "objectName": {
          "type": "string"
        },
        "nativeName": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "creditLine": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "placeName": {
          "type": "string"
        },
        "siteName": {
          "type": "string"
        },
        "culture": {
          "type": "string"
        },
        "cultureArea": {
          "type": "string"
        },
        "locus": {
          "type": "string"
        },
        "period": {
          "type": "string"
        },
        "material": {
          "type": "string"
        },
        "technique": {
          "type": "string"
        },
        "creator": {
          "type": "string"
        },
        "iconography": {
          "type": "string"
        },
        "iconographySubject": {
          "type": "string"
        },
        "inscriptionMarkLanguage": {
          "type": "string"
        },
        "dateMade": {
          "type": "string"
        },
        "earlyDate": {
          "type": "string"
        },
        "lateDate": {
          "type": "string"
        },
        "depth": {
          "type": "string"
        },
        "length": {
          "type": "string"
        },
        "width": {
          "type": "string"
        },
        "height": {
          "type": "string"
        },
        "thickness": {
          "type": "string"
        },
        "weight": {
          "type": "string"
        },
        "outsideDiameter": {
          "type": "string"
        },
        "measurementUnit": {
          "type": "string"
        }
      }
    }
  }
}
