        },
        "target_seal_sha256": {
          "$ref": "#/$defs/checksum"
        },
        "transcription_seal_sha256": {
          "$ref": "#/$defs/checksum"
        }
      },
      "required": [
        "claim_slot_reservation_sha256",
        "context_contract_sha256",
        "custody_contract_sha256",
        "evaluator_bundle_sha256",
        "freeze_sequence_sha256",
        "gate_plan_sha256",
        "identifier_key_ceremony_sha256",
        "manifest_sha256_domain",
        "parent_protocol_sha256",
        "population_inventory_sha256",
        "population_freeze_claim_sha256",
        "preinventory_contract_sha256",
        "relation_policy_sha256",
        "rights_evidence_set_sha256",
        "source_frame_sha256",
        "split_structural_input_sha256",
        "target_seal_sha256",
        "transcription_seal_sha256"
      ],
      "type": "object"
    },
    "claim_policy": {
      "additionalProperties": false,
      "properties": {
