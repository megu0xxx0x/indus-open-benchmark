{
  "$defs": {
    "checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "checksum_or_null": {
      "oneOf": [
        {
          "$ref": "#/$defs/checksum"
        },
        {
          "type": "null"
        }
      ]
    },
    "closure_group": {
      "additionalProperties": false,
      "properties": {
        "group_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "member_value_ids": {
          "items": {
            "$ref": "#/$defs/opaque_id"
          },
          "maxItems": 20000,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "group_id",
        "member_value_ids"
      ],
      "type": "object"
    },
    "closure_table": {
      "additionalProperties": false,
      "properties": {
        "axis": {
          "enum": [
            "site",
            "period",
            "medium",
            "object_type"
          ]
        },
        "groups": {
          "items": {
            "$ref": "#/$defs/closure_group"
          },
          "maxItems": 512,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "axis",
        "groups"
      ],
      "type": "object"
    },
    "context": {
      "additionalProperties": false,
      "properties": {
        "medium": {
          "$ref": "#/$defs/opaque_id_or_null"
        },
        "nuisance": {
          "items": {
            "$ref": "#/$defs/opaque_id"
          },
          "maxItems": 16,
          "type": "array"
        },
        "object_type": {
          "$ref": "#/$defs/opaque_id_or_null"
        },
        "period": {
          "$ref": "#/$defs/opaque_id_or_null"
        },
        "site": {
          "$ref": "#/$defs/opaque_id_or_null"
        }
      },
      "required": [
        "medium",
        "nuisance",
        "object_type",
        "period",
        "site"
      ],
      "type": "object"
    },
    "eligibility_reason": {
      "enum": [
        "ELIGIBLE",
        "CONTEXT_INCOMPLETE_OR_CONFLICTING",
        "IDENTITY_UNRESOLVED",
        "NOT_PHYSICAL_ORIGINAL",
        "PROVENANCE_INCOMPLETE",
        "RIGHTS_INSUFFICIENT",
        "SOURCE_BINDING_INCOMPLETE",
        "TARGET_AMBIGUOUS_OR_CONFLICTING",
        "TARGET_IMPUTED_OR_DERIVED",
        "TARGET_MISSING",
        "TARGET_UNIT_INCOMPATIBLE",
        "TRANSCRIPTION_INCOMPLETE_OR_AMBIGUOUS"
      ]
    },
    "eligibility_row": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "reason_codes": {
                "not": {
                  "contains": {
                    "const": "ELIGIBLE"
                  }
                }
              }
            }
          },
          "if": {
            "properties": {
              "eligible": {
                "const": true
              }
            },
            "required": [
              "eligible"
            ]
          },
          "then": {
            "properties": {
              "reason_codes": {
                "const": [
                  "ELIGIBLE"
                ]
              }
            }
          }
        }
      ],
      "properties": {
        "all_applicable_reason_codes_recorded": {
          "const": true
        },
        "attestation_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "eligible": {
          "type": "boolean"
        },
        "f_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "g_exclusion_reason": {
          "enum": [
            "NONE",
            "DEPENDENCE_COMPONENT",
            "PRIOR_EXPOSURE_COMPONENT",
            "CONFLICT_COMPONENT"
          ]
        },
        "prior_project_exposure": {
          "type": "boolean"
        },
        "reason_codes": {
          "items": {
            "$ref": "#/$defs/eligibility_reason"
          },
          "maxItems": 12,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "all_applicable_reason_codes_recorded",
        "attestation_id",
        "eligible",
        "f_id",
        "g_exclusion_reason",
        "prior_project_exposure",
        "reason_codes"
      ],
      "type": "object"
    },
    "freeze_receipt": {
      "additionalProperties": false,
      "properties": {
        "attestor_key_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "receipt_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "receipt_kind": {
          "enum": [
            "claim_slot_reservation",
            "identifier_key_ceremony",
            "preinventory_contract",
            "clean_roles_first_claim_instance_source_metadata_access",
            "earliest_transcription_x_access",
            "earliest_target_y_access",
            "transcription_seal",
            "target_seal",
            "population_freeze_claim"
          ]
        },
        "recorded_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "type": "string"
        },
        "signed_receipt_evidence_sha256": {
          "$ref": "#/$defs/checksum"
        },
        "subject_sha256": {
          "$ref": "#/$defs/checksum"
        }
      },
      "required": [
        "attestor_key_id",
        "recorded_at",
        "receipt_kind",
        "receipt_id",
        "signed_receipt_evidence_sha256",
        "subject_sha256"
      ],
      "type": "object"
    },
    "nuisance_vocabulary": {
      "additionalProperties": false,
      "properties": {
        "canonical_value_ids": {
          "items": {
            "$ref": "#/$defs/opaque_id"
          },
          "maxItems": 20000,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "field_id": {
          "$ref": "#/$defs/opaque_id"
        }
      },
      "required": [
        "canonical_value_ids",
        "field_id"
      ],
      "type": "object"
    },
    "opaque_id": {
      "pattern": "^hmac-sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "opaque_id_or_null": {
      "oneOf": [
        {
          "$ref": "#/$defs/opaque_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "permission_status": {
      "enum": [
        "permitted",
        "denied",
        "unknown",
        "not_applicable"
      ]
    },
    "positive_decimal_integer_string": {
      "pattern": "^[1-9][0-9]*$",
      "type": "string"
    },
    "registry_id": {
      "pattern": "^registry-id:[0-9a-f]{64}$",
      "type": "string"
    },
    "relation": {
      "additionalProperties": false,
      "properties": {
        "disposition": {
          "enum": [
            "union",
            "exclude_both"
          ]
        },
        "evidence_envelope_sha256": {
          "$ref": "#/$defs/checksum"
        },
        "kind": {
          "enum": [
            "cast_or_impression",
            "common_mold_or_template",
            "exact_normalized_sequence",
            "production_batch",
            "workshop",
            "recovery_locus",
            "assemblage",
            "unresolved_dependence"
          ]
        },
        "left_f_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "right_f_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "status": {
          "enum": [
            "confirmed",
            "possible",
            "unresolved"
          ]
        }
      },
      "required": [
        "disposition",
        "evidence_envelope_sha256",
        "kind",
        "left_f_id",
        "right_f_id",
        "status"
      ],
      "type": "object"
    },
    "rights_row": {
      "additionalProperties": false,
      "properties": {
        "evidence_sha256": {
          "$ref": "#/$defs/checksum_or_null"
        },
        "layer": {
          "enum": [
            "source_frame_metadata",
            "transcription_x",
            "context_c",
            "physical_identity_f",
            "dependence_g",
            "target_y",
            "derived_aggregate"
          ]
        },
        "purposes": {
          "additionalProperties": false,
          "properties": {
            "analyze": {
              "$ref": "#/$defs/permission_status"
            },
            "custodial_transfer": {
              "$ref": "#/$defs/permission_status"
            },
            "derive": {
              "$ref": "#/$defs/permission_status"
            },
            "prize_submit": {
              "$ref": "#/$defs/permission_status"
            },
            "publish_aggregate": {
              "$ref": "#/$defs/permission_status"
            },
            "publish_item": {
              "$ref": "#/$defs/permission_status"
            },
            "retain_protected": {
              "$ref": "#/$defs/permission_status"
            },
            "retrieve": {
              "$ref": "#/$defs/permission_status"
            }
          },
          "required": [
            "analyze",
            "custodial_transfer",
            "derive",
            "prize_submit",
            "publish_aggregate",
            "publish_item",
            "retain_protected",
            "retrieve"
          ],
          "type": "object"
        }
      },
      "required": [
        "evidence_sha256",
        "layer",
        "purposes"
      ],
      "type": "object"
    },
    "sealed_dataset": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "data_layer": {
                "const": "target_y"
              }
            },
            "required": [
              "data_layer"
            ]
          },
          "then": {
            "properties": {
              "contract": {
                "properties": {
                  "archive_custodian_role": {
                    "const": "independent_target_archive_custodian"
                  },
                  "payload_scope": {
                    "const": "all_F_to_exact_rational_Y_or_explicit_status_with_family_unit_conversion_missingness_and_repeated_resolution"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "data_layer": {
                "const": "transcription_x"
              }
            },
            "required": [
              "data_layer"
            ]
          },
          "then": {
            "properties": {
              "contract": {
                "properties": {
                  "archive_custodian_role": {
                    "const": "independent_transcription_archive_custodian"
                  },
                  "payload_scope": {
                    "const": "all_F_to_approved_X_or_explicit_status_with_side_line_token_allograph_order_and_source_revision_binding"
                  }
                }
              }
            }
          }
        }
      ],
      "properties": {
        "commitment": {
          "$ref": "#/$defs/sealed_dataset_commitment"
        },
        "contract": {
          "$ref": "#/$defs/sealed_dataset_contract"
        },
        "data_layer": {
          "enum": [
            "target_y",
            "transcription_x"
          ]
        }
      },
      "required": [
        "commitment",
        "contract",
        "data_layer"
      ],
      "type": "object"
    },
    "sealed_dataset_commitment": {
      "additionalProperties": false,
      "properties": {
        "canonical_f_order": {
          "const": true
        },
        "ciphertext_archive_manifest_sha256": {
          "$ref": "#/$defs/checksum"
        },
        "ciphertext_merkle_root_sha256": {
          "$ref": "#/$defs/checksum"
        },
        "committed_f_count": {
          "maximum": 20000,
          "minimum": 1,
          "type": "integer"
        },
        "complete_f_roster_covered": {
          "const": true
        },
        "ordered_f_roster_sha256": {
          "$ref": "#/$defs/checksum"
        },
        "plaintext_digest_present": {
          "const": false
        },
        "seal_created_before_population_receipt": {
          "const": true
        }
      },
      "required": [
        "canonical_f_order",
        "committed_f_count",
        "complete_f_roster_covered",
        "ordered_f_roster_sha256",
        "ciphertext_archive_manifest_sha256",
        "ciphertext_merkle_root_sha256",
        "plaintext_digest_present",
        "seal_created_before_population_receipt"
      ],
      "type": "object"
    },
    "sealed_dataset_contract": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "XChaCha20-Poly1305-record-AEAD-SHA256-Merkle-v1"
        },
        "archive_custodian_role": {
          "enum": [
            "independent_target_archive_custodian",
            "independent_transcription_archive_custodian"
          ]
        },
        "canonical_payload_contract_sha256": {
          "$ref": "#/$defs/checksum"
        },
        "encryption_profile_sha256": {
          "$ref": "#/$defs/checksum"
        },
        "independent_random_record_keys": {
          "const": true
        },
        "leaf_aad_contract_sha256": {
          "$ref": "#/$defs/checksum"
        },
        "merkle_profile_sha256": {
          "$ref": "#/$defs/checksum"
        },
        "payload_scope": {
          "enum": [
            "all_F_to_approved_X_or_explicit_status_with_side_line_token_allograph_order_and_source_revision_binding",
            "all_F_to_exact_rational_Y_or_explicit_status_with_family_unit_conversion_missingness_and_repeated_resolution"
          ]
        },
        "record_keys_independently_wrapped_for_staged_release": {
          "const": true
        },
        "separate_archive_and_keys_from_other_layer": {
          "const": true
        },
        "unique_random_nonce_per_record": {
          "const": true
        }
      },
      "required": [
        "algorithm",
        "archive_custodian_role",
        "canonical_payload_contract_sha256",
        "encryption_profile_sha256",
        "independent_random_record_keys",
        "leaf_aad_contract_sha256",
        "merkle_profile_sha256",
        "payload_scope",
        "record_keys_independently_wrapped_for_staged_release",
        "separate_archive_and_keys_from_other_layer",
        "unique_random_nonce_per_record"
      ],
      "type": "object"
    },
    "source_record": {
      "additionalProperties": false,
      "properties": {
        "f_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "source_entry_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "source_entry_kind": {
          "enum": [
            "catalog_record",
            "cross_edition_record",
            "publication_view",
            "image_view",
            "fragment_record",
            "duplicate_record"
          ]
        },
        "source_order": {
          "maximum": 99999,
          "minimum": 0,
          "type": "integer"
        },
        "source_record_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "source_revision_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "source_view_id": {
          "$ref": "#/$defs/opaque_id"
        }
      },
      "required": [
        "f_id",
        "source_entry_id",
        "source_entry_kind",
        "source_order",
        "source_record_id",
        "source_revision_id",
        "source_view_id"
      ],
      "type": "object"
    },
    "unit": {
      "additionalProperties": false,
      "properties": {
        "context": {
          "$ref": "#/$defs/context"
        },
        "context_evidence_envelope_sha256": {
          "$ref": "#/$defs/checksum"
        },
        "f_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "physical_identity_evidence_envelope_sha256": {
          "$ref": "#/$defs/checksum"
        },
        "relation_coverage_evidence_envelope_sha256": {
          "$ref": "#/$defs/checksum"
        },
        "source_membership_complete": {
          "const": true
        }
      },
      "required": [
        "context",
        "context_evidence_envelope_sha256",
        "f_id",
        "physical_identity_evidence_envelope_sha256",
        "relation_coverage_evidence_envelope_sha256",
        "source_membership_complete"
      ],
      "type": "object"
    }
  },
  "$id": "nmfa-value-blind-preregistration-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
