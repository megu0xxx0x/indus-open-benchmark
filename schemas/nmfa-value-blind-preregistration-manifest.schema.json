          "const": true
        },
        "claim_family_id": {
          "$ref": "#/$defs/registry_id"
        },
        "claim_slot_id": {
          "$ref": "#/$defs/registry_id"
        },
        "external_registry_single_active_chain_required": {
          "const": true
        },
        "fork_or_parallel_registration_forbidden": {
          "const": true
        },
        "prior_chain_head_sha256": {
          "$ref": "#/$defs/checksum_or_null"
        },
        "registry_scope_evidence_sha256": {
          "$ref": "#/$defs/checksum"
        },
        "supersession_after_external_registration_forbidden": {
          "const": true
        }
      },
      "required": [
        "aborted_and_prior_slots_must_be_enumerable",
        "claim_family_id",
        "claim_slot_id",
        "external_registry_single_active_chain_required",
        "fork_or_parallel_registration_forbidden",
        "prior_chain_head_sha256",
        "registry_scope_evidence_sha256",
        "supersession_after_external_registration_forbidden"
      ],
      "type": "object"
    },
    "context_contract": {
      "additionalProperties": false,
      "properties": {
        "alias_and_descendant_closures_frozen": {
          "type": "boolean"
        },
        "axis_mapping_rule_sha256": {
          "$ref": "#/$defs/checksum"
        },
        "canonical_vocabularies_frozen": {
          "type": "boolean"
        },
        "closure_tables": {
          "items": {
            "$ref": "#/$defs/closure_table"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        },
        "multiple_or_overlapping_values_ineligible": {
          "const": true
        },
        "nuisance_field_ids": {
          "items": {
            "$ref": "#/$defs/opaque_id"
          },
          "maxItems": 16,
          "type": "array",
          "uniqueItems": true
        },
        "nuisance_fields_complete": {
          "type": "boolean"
        },
        "nuisance_mapping_rule_sha256": {
          "$ref": "#/$defs/checksum"
        },
        "nuisance_value_vocabularies_sha256": {
          "$ref": "#/$defs/checksum"
        },
        "nuisance_vocabularies": {
          "items": {
            "$ref": "#/$defs/nuisance_vocabulary"
          },
          "maxItems": 16,
          "type": "array"
        },
        "provenance_policy": {
          "enum": [
            "single_prespecified_regime",
            "complete_canonical_nuisance_tuple",
            "incomplete"
          ]
        },
        "single_regime_contract_sha256": {
          "$ref": "#/$defs/checksum_or_null"
        },
        "taxonomy_evidence_sha256": {
          "$ref": "#/$defs/checksum"
        },
        "unknown_values_ineligible": {
          "const": true
        }
      },
      "required": [
        "alias_and_descendant_closures_frozen",
        "axis_mapping_rule_sha256",
        "canonical_vocabularies_frozen",
        "closure_tables",
        "multiple_or_overlapping_values_ineligible",
        "nuisance_fields_complete",
        "nuisance_field_ids",
        "nuisance_mapping_rule_sha256",
        "nuisance_value_vocabularies_sha256",
        "nuisance_vocabularies",
        "provenance_policy",
        "single_regime_contract_sha256",
        "taxonomy_evidence_sha256",
        "unknown_values_ineligible"
      ],
      "type": "object"
    },
    "created_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    },
    "eligibility": {
      "items": {
        "$ref": "#/$defs/eligibility_row"
      },
      "maxItems": 20000,
      "minItems": 1,
      "type": "array"
    },
    "evidence_envelope_contract": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
