{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/indus-open-benchmark/museum-review-subject.schema.json",
  "title": "Catalog-blind museum review subject",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_id",
    "subject_id",
    "record_state",
    "privacy_classification",
    "scientific_scope",
    "view_groups",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "packet_id": {
      "$ref": "#/$defs/stable_id"
    },
    "subject_id": {
      "$ref": "#/$defs/stable_id"
    },
    "record_state": {
      "const": "human_observation_review_pending"
    },
    "privacy_classification": {
      "const": "catalog_blind_private_review"
    },
    "scientific_scope": {
      "const": "physical and catalog observation only; no sign reading, phonetic, language, semantic, or translation inference"
    },
    "view_groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/view_group"
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "stable_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,159}$"
    },
    "checksum": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "relative_path": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "view_group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "view_group_id",
        "evidence_images"
      ],
      "properties": {
        "view_group_id": {
          "$ref": "#/$defs/stable_id"
        },
        "evidence_images": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence_image"
          }
        }
      }
    },
    "evidence_image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image_id",
        "sha256",
        "bytes",
        "content_type",
        "relative_path"
      ],
      "properties": {
        "image_id": {
          "$ref": "#/$defs/stable_id"
        },
        "sha256": {
          "$ref": "#/$defs/checksum"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "content_type": {
          "enum": [
            "image/jpeg",
            "image/png",
            "image/tiff",
            "image/x-tiff"
          ]
        },
        "relative_path": {
          "$ref": "#/$defs/relative_path"
        }
      }
    }
  }
}
