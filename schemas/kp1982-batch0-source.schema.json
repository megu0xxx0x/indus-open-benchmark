{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/indus-open-benchmark/kp1982-batch0-source.schema.json",
  "title": "Fixed KP1982 Batch 0 source contract",
  "description": "A closed public-source identity and page-geometry contract. It contains no transcription, interpretation, or decipherment result.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "status",
    "scientific_scope",
    "source",
    "target_pages",
    "coordinate_contract",
    "layout_contract",
    "assurances"
  ],
  "properties": {
