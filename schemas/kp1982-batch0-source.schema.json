            "canonical_pbm_sha256": {
              "$ref": "#/$defs/checksum"
            },
            "pixel_payload_byte_size": {
              "const": 4096755
            },
            "pixel_payload_sha256": {
              "$ref": "#/$defs/checksum"
            },
            "decoder_crosscheck": {
              "const": "pixel_equal_poppler_pdfimages_26.04.0_and_mupdf_mutool_1.27.2"
            }
          }
        }
      }
