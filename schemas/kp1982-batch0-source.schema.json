                "page_index": {
                  "const": 20
                },
                "printed_page_label": {
                  "const": "21"
                },
                "pdf_image_object_number": {
                  "const": 66
                },
                "embedded_image": {
                  "properties": {
                    "canonical_pbm_sha256": {
                      "const": "sha256:c6313d5e597e723f8d3f9c4118d1aaf5d53a05c22b3dc557a8c2b65178445330"
