            6705
          ]
        },
        "normalization_status": {
          "const": "native_pixels_first_transform_not_yet_admitted"
        }
      }
    },
    "layout_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lane_count_per_page",
        "record_components",
        "row_anchor_status",
        "ocr_authority"
