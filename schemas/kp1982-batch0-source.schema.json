                    "pixel_payload_sha256": {
                      "const": "sha256:e4d3a1b7f6889cf1f39f4ddbcf2f5919922e7b433a5d2a6960a86e4de30658e8"
                    }
                  }
                }
              }
            }
          ]
        }
      ],
      "items": false
    },
    "coordinate_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_space",
        "origin",
        "rectangle_encoding",
        "bounds",
        "normalization_status"
      ],
      "properties": {
