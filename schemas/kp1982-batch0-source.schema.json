                  "properties": {
                    "canonical_pbm_sha256": {
                      "const": "sha256:092fa7fc48434e68e71aba57db858db5c82151d12692d6018fa836b66ee992cc"
                    },
                    "pixel_payload_sha256": {
                      "const": "sha256:5e66e4d435cde3db56658b94309a232096d3fa951c56730cbb22f7d69b088f91"
                    }
                  }
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/page"
            },
            {
              "properties": {
                "pdf_page_number": {
                  "const": 21
