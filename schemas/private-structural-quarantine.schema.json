{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "private-structural-quarantine.schema.json",
  "title": "IndusBench private structural quarantine ledger",
  "description": "A private, content-bound inventory of fixed-code CSV, JSON, and JSONL structural findings. It copies no source values and never overrides readiness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ledger_kind",
    "created_at",
    "scope",
    "parser_contract",
    "scan_completed",
    "inventory_complete",
    "file_quarantine_coverage_complete",
    "anomaly_enumeration_complete",
    "source_data_modified",
    "readiness_override",
    "clean_files_omitted",
    "privacy",
    "assurance",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "ledger_kind": {
      "const": "private_corpus_structural_quarantine"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "const": "csv_json_jsonl_structure"
    },
    "parser_contract": {
      "const": "indusbench.private-structured-records.v1"
    },
    "scan_completed": {
      "const": true
    },
    "inventory_complete": {
      "const": true
    },
    "file_quarantine_coverage_complete": {
      "const": true
    },
    "anomaly_enumeration_complete": {
      "const": true
    },
    "source_data_modified": {
      "const": false
    },
    "readiness_override": {
      "const": false
    },
    "clean_files_omitted": {
      "const": true
    },
    "privacy": {
      "$ref": "#/$defs/privacy"
    },
    "assurance": {
      "$ref": "#/$defs/assurance"
    },
    "entries": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exact_paths_included",
        "content_digests_included",
        "headers_included",
        "source_identifiers_included",
        "private_values_included",
        "exception_text_included",
        "publication_review_required"
      ],
      "properties": {
        "exact_paths_included": {
          "const": false
        },
        "content_digests_included": {
          "const": true
        },
        "headers_included": {
          "const": false
        },
        "source_identifiers_included": {
          "const": false
        },
        "private_values_included": {
          "const": false
        },
        "exception_text_included": {
          "const": false
        },
        "publication_review_required": {
          "const": true
        }
      }
    },
    "assurance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blind_claim_allowed",
        "final_evaluation_eligible",
        "independent_custody_attested",
        "external_custodian_attested",
        "trusted_timestamp_attested",
        "access_history_attested",
        "confidentiality_attested",
        "rights_ownership_attested",
        "provenance_authenticity_attested",
        "future_immutability_attested",
        "decipherment_claim_allowed",
        "prize_submission_eligible"
      ],
      "properties": {
        "blind_claim_allowed": {
          "const": false
        },
        "final_evaluation_eligible": {
          "const": false
        },
        "independent_custody_attested": {
          "const": false
        },
        "external_custodian_attested": {
          "const": false
        },
        "trusted_timestamp_attested": {
          "const": false
        },
        "access_history_attested": {
          "const": false
        },
        "confidentiality_attested": {
          "const": false
        },
        "rights_ownership_attested": {
          "const": false
        },
        "provenance_authenticity_attested": {
          "const": false
        },
        "future_immutability_attested": {
          "const": false
        },
        "decipherment_claim_allowed": {
          "const": false
        },
        "prize_submission_eligible": {
          "const": false
        }
      }
    },
    "anomaly": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "record_number",
        "expected_columns",
        "observed_columns"
      ],
      "properties": {
        "code": {
          "enum": [
            "ANOMALY_LIMIT_EXCEEDED",
            "CSV_COLUMN_LIMIT_EXCEEDED",
            "CSV_EMPTY_DOCUMENT",
            "CSV_PARSE_ERROR",
            "CSV_RECORD_LIMIT_EXCEEDED",
            "CSV_ROW_LIMIT_EXCEEDED",
            "CSV_ROW_WIDTH_MISMATCH",
            "INVALID_UTF8",
            "JSON_COMPLEXITY_LIMIT_EXCEEDED",
            "JSON_DOCUMENT_INVALID",
            "JSONL_EMPTY_DOCUMENT",
            "JSONL_RECORD_INVALID",
            "JSONL_RECORD_LIMIT_EXCEEDED",
            "JSONL_RECORD_NOT_OBJECT",
            "NUL_BYTE_PRESENT",
            "STRUCTURED_DOCUMENT_TOO_LARGE",
            "UTF8_BOM_PRESENT"
          ]
        },
        "record_number": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "expected_columns": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "observed_columns": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "code": {
                "const": "CSV_ROW_WIDTH_MISMATCH"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "record_number": {
                "type": "integer",
                "minimum": 2
              },
              "expected_columns": {
                "type": "integer",
                "minimum": 0
              },
              "observed_columns": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      ]
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_entry_index",
        "content_sha256",
        "format",
        "analysis_complete",
        "anomalies"
      ],
      "properties": {
        "policy_entry_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4095
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "format": {
          "enum": [
            "csv",
            "json",
            "jsonl"
          ]
        },
        "analysis_complete": {
          "const": true
        },
        "anomalies": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/anomaly"
          }
        }
      }
    }
  }
}
