{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "private-corpus-policy.schema.json",
  "title": "IndusBench private corpus use policy",
  "description": "A closed, exact-byte-bound curator policy for local non-public corpus use. Pending review is always blocking. Validation does not confer rights, attest provenance, or make a readiness or assurance claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_kind",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "policy_kind": {
      "const": "private_corpus_use_policy"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))[^/\\\\\\u0000-\\u001F\\u007F]+(?:/[^/\\\\\\u0000-\\u001F\\u007F]+)*$"
    },
    "stable_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path",
        "content_sha256",
        "curation_status",
        "content_layer",
        "source_id",
        "source_locator",
        "source_revision",
        "provenance_status",
        "rights_status",
        "rights_evidence_status",
        "permitted_uses"
      ],
      "properties": {
        "relative_path": {
          "$ref": "#/$defs/relative_path"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "curation_status": {
          "enum": [
            "pending",
            "reviewed"
          ]
        },
        "content_layer": {
          "enum": [
            "metadata",
            "transcription",
            "image",
            "catalog_scan",
            "documentation",
            "derived_statistics",
            "configuration",
            "model_artifact",
            "unknown"
          ]
        },
        "source_id": {
          "$ref": "#/$defs/stable_id"
        },
        "source_locator": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 2000
        },
        "source_revision": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256
        },
        "provenance_status": {
          "enum": [
            "documented",
            "partial",
            "unknown",
            "disputed"
          ]
        },
        "rights_status": {
          "enum": [
            "public_domain",
            "open_licensed",
            "permission_granted",
            "metadata_only",
            "restricted",
            "unknown"
          ]
        },
        "rights_evidence_status": {
          "enum": [
            "documented",
            "missing",
            "ambiguous",
            "conflicting"
          ]
        },
        "permitted_uses": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "local_nonpublic_research",
              "local_nonpublic_normalization"
            ]
          }
        }
      }
    }
  }
}
