{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mtaac-v5-development-report.schema.json",
  "title": "MTAAC V5 aggregate group-contrast CRF development report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "analysis",
    "claim_scope",
    "data_boundary",
    "development_only",
    "final_development_model",
    "gate_decision",
    "implementation_commit",
    "model_contract",
    "model_executed",
    "mtaac_retired",
    "outer_development",
    "parent_commitments",
    "plan_sha256",
    "profile_contract",
    "report_version",
    "scientific_metrics_emitted",
    "terminal_status"
  ],
  "properties": {
    "analysis": {
      "const": "mtaac_v5_group_contrast_crf_development"
    },
    "claim_scope": {
      "$ref": "#/$defs/claim_scope"
    },
    "data_boundary": {
      "$ref": "#/$defs/data_boundary"
    },
    "development_only": {
      "const": true
    },
    "final_development_model": {
      "$ref": "#/$defs/final_model"
    },
    "gate_decision": {
      "$ref": "#/$defs/gate_decision"
    },
    "implementation_commit": {
      "$ref": "#/$defs/commit"
    },
    "model_contract": {
      "$ref": "#/$defs/model_contract"
    },
    "model_executed": {
      "const": true
    },
    "mtaac_retired": {
      "const": true
    },
    "outer_development": {
      "$ref": "#/$defs/outer_development"
    },
    "parent_commitments": {
      "$ref": "#/$defs/parent_commitments"
    },
    "plan_sha256": {
      "const": "sha256:3c4a7c733218fcd0c4e6e25fbd59e5b86c1fd589512e9a88bb243b1d036c10f1"
    },
    "profile_contract": {
      "$ref": "#/$defs/profile_contract"
    },
    "report_version": {
      "const": "mtaac-v5-development-report-v1"
    },
    "scientific_metrics_emitted": {
      "const": true
    },
    "terminal_status": {
      "enum": [
        "advance_to_prospective_freeze",
        "mtaac_retired"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "terminal_status": {
            "const": "advance_to_prospective_freeze"
          }
        },
        "required": [
          "terminal_status"
        ]
      },
      "then": {
        "properties": {
          "final_development_model": {
            "$ref": "#/$defs/advanced_final_model"
          },
          "gate_decision": {
            "$ref": "#/$defs/advance_gate_decision"
          }
        }
      },
      "else": {
        "properties": {
          "final_development_model": {
            "$ref": "#/$defs/retired_final_model"
          },
          "gate_decision": {
            "$ref": "#/$defs/retired_gate_decision"
          }
        }
      }
    }
  ],
  "$defs": {
    "advanced_final_model": {
      "allOf": [
        {
          "$ref": "#/$defs/final_model"
        },
        {
          "properties": {
            "fitted": {
              "const": true
            },
            "model_state_commitment": {
              "$ref": "#/$defs/checksum"
            },
            "optimizer": {
              "$ref": "#/$defs/optimizer_run"
            }
          }
        }
      ]
    },
    "advance_gate_decision": {
      "allOf": [
        {
          "$ref": "#/$defs/gate_decision"
        },
        {
          "properties": {
            "all_passed": {
              "const": true
            },
            "terminal_status": {
              "const": "advance_to_prospective_freeze"
            }
          }
        }
      ]
    },
    "checksum": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "claim_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "eligible_as_binding_confirmation",
        "eligible_as_decipherment",
        "eligible_as_reserved_validation_result",
        "eligible_as_v2_holdout_result",
        "individual_predictions_published",
        "prospective_execution_requires_separate_public_freeze"
      ],
      "properties": {
        "class": {
          "const": "development_only"
        },
        "eligible_as_binding_confirmation": {
          "const": false
        },
        "eligible_as_decipherment": {
          "const": false
        },
        "eligible_as_reserved_validation_result": {
          "const": false
        },
        "eligible_as_v2_holdout_result": {
          "const": false
        },
        "individual_predictions_published": {
          "const": false
        },
        "prospective_execution_requires_separate_public_freeze": {
          "const": true
        }
      }
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "confusion_matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_only",
        "person_name",
        "quantity",
        "settlement_name",
        "unit"
      ],
      "properties": {
        "context_only": {
          "$ref": "#/$defs/confusion_row"
        },
        "person_name": {
          "$ref": "#/$defs/confusion_row"
        },
        "quantity": {
          "$ref": "#/$defs/confusion_row"
        },
        "settlement_name": {
          "$ref": "#/$defs/confusion_row"
        },
        "unit": {
          "$ref": "#/$defs/confusion_row"
        }
      }
    },
    "confusion_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_only",
        "person_name",
        "quantity",
        "settlement_name",
        "unit"
      ],
      "properties": {
        "context_only": {
          "$ref": "#/$defs/mass"
        },
        "person_name": {
          "$ref": "#/$defs/mass"
        },
        "quantity": {
          "$ref": "#/$defs/mass"
        },
        "settlement_name": {
          "$ref": "#/$defs/mass"
        },
        "unit": {
          "$ref": "#/$defs/mass"
        }
      }
    },
    "data_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_training_family_count",
        "mtaac_final_attempt",
        "regimes_used",
        "replica_index_used",
        "reserved_validation_source_loaded",
        "v2_holdout_exposed_to_model",
        "v2_holdout_family_count_excluded",
        "v2_holdout_scored"
      ],
      "properties": {
        "model_training_family_count": {
          "const": 271
        },
        "mtaac_final_attempt": {
          "const": true
        },
        "regimes_used": {
          "const": [
            "clean",
            "mild"
          ]
        },
        "replica_index_used": {
          "const": 0
        },
        "reserved_validation_source_loaded": {
          "const": false
        },
        "v2_holdout_exposed_to_model": {
          "const": false
        },
        "v2_holdout_family_count_excluded": {
          "const": 90
        },
        "v2_holdout_scored": {
          "const": false
        }
      }
    },
    "feature_value_types": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local",
        "missing_or_boundary",
        "profile_numeric",
        "type_support"
      ],
      "properties": {
        "local": {
          "const": "fixed_categorical"
        },
        "missing_or_boundary": {
          "const": "fixed_categorical_marker"
        },
        "profile_numeric": {
          "const": "direct_float64_in_closed_unit_interval"
        },
        "type_support": {
          "const": "fixed_categorical"
        }
      }
    },
    "final_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fit_rule",
        "fitted",
        "model_state_commitment",
        "optimizer"
      ],
      "properties": {
        "fit_rule": {
          "const": "fit_all_271_families_only_after_advance_to_prospective_freeze"
        },
        "fitted": {
          "type": "boolean"
        },
        "model_state_commitment": {
          "oneOf": [
            {
              "$ref": "#/$defs/checksum"
            },
            {
              "type": "null"
            }
          ]
        },
        "optimizer": {
          "oneOf": [
            {
              "$ref": "#/$defs/optimizer_run"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "fold_count_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum",
        "observed",
        "passed"
      ],
      "properties": {
        "minimum": {
          "const": 4
        },
        "observed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "passed": {
          "type": "boolean"
        }
      }
    },
    "fold_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clean",
        "mild"
      ],
      "properties": {
        "clean": {
          "$ref": "#/$defs/metrics"
        },
        "mild": {
          "$ref": "#/$defs/metrics"
        }
      }
    },
    "fold_support": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "train_family_count",
        "train_state_support",
        "validation_family_count",
        "validation_state_support"
      ],
      "properties": {
        "train_family_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 270
        },
        "train_state_support": {
          "$ref": "#/$defs/state_support"
        },
        "validation_family_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 270
        },
        "validation_state_support": {
          "$ref": "#/$defs/state_support"
        }
      }
    },
    "gate_check_clean_macro": {
      "$ref": "#/$defs/minimum_check",
      "properties": {
        "minimum": {
          "const": 0.4680972874281771
        }
      }
    },
    "gate_check_clean_settlement": {
      "$ref": "#/$defs/minimum_check",
      "properties": {
        "minimum": {
          "const": 0.1
        }
      }
    },
    "gate_check_context": {
      "$ref": "#/$defs/minimum_check",
      "properties": {
        "minimum": {
          "const": 0.520654531441017
        }
      }
    },
    "gate_check_macro": {
      "$ref": "#/$defs/minimum_check",
      "properties": {
        "minimum": {
          "const": 0.3977588813953674
        }
      }
    },
    "gate_check_person": {
      "$ref": "#/$defs/minimum_check",
      "properties": {
        "minimum": {
          "const": 0.4988092152820551
        }
      }
    },
    "gate_check_quantity": {
      "$ref": "#/$defs/minimum_check",
      "properties": {
        "minimum": {
          "const": 0.1765055025096581
        }
      }
    },
    "gate_check_settlement_precision": {
      "$ref": "#/$defs/minimum_check",
      "properties": {
        "minimum": {
          "const": 0.20747537967348736
        }
      }
    },
    "gate_check_settlement_recall": {
      "$ref": "#/$defs/minimum_check",
      "properties": {
        "minimum": {
          "const": 0.15
        }
      }
    },
    "gate_check_unit_precision": {
      "$ref": "#/$defs/minimum_check",
      "properties": {
        "minimum": {
          "const": 0.3512887014608468
        }
      }
    },
    "gate_check_unit_recall": {
      "$ref": "#/$defs/minimum_check",
      "properties": {
        "minimum": {
          "const": 0.3767836311289388
        }
      }
    },
    "gate_check_unit_worst_fold": {
      "$ref": "#/$defs/minimum_check",
      "properties": {
        "minimum": {
          "const": 0.18225197064754597
        }
      }
    },
    "gate_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clean_macro_f1",
        "clean_settlement_name_recall",
        "mild_macro_f1",
        "mild_precision_floors",
        "mild_recall_floors",
        "positive_mild_macro_f1_delta_outer_fold_count",
        "positive_mild_settlement_name_recall_delta_outer_fold_count",
        "positive_mild_unit_recall_delta_outer_fold_count",
        "settlement_name_positive_recall_outer_fold_count",
        "unit_worst_outer_fold_recall"
      ],
      "properties": {
        "clean_macro_f1": {
          "$ref": "#/$defs/gate_check_clean_macro"
        },
        "clean_settlement_name_recall": {
          "$ref": "#/$defs/gate_check_clean_settlement"
        },
        "mild_macro_f1": {
          "$ref": "#/$defs/gate_check_macro"
        },
        "mild_precision_floors": {
          "$ref": "#/$defs/precision_floor_checks"
        },
        "mild_recall_floors": {
          "$ref": "#/$defs/recall_floor_checks"
        },
        "positive_mild_macro_f1_delta_outer_fold_count": {
          "$ref": "#/$defs/fold_count_check"
        },
        "positive_mild_settlement_name_recall_delta_outer_fold_count": {
          "$ref": "#/$defs/fold_count_check"
        },
        "positive_mild_unit_recall_delta_outer_fold_count": {
          "$ref": "#/$defs/fold_count_check"
        },
        "settlement_name_positive_recall_outer_fold_count": {
          "$ref": "#/$defs/positive_every_fold_check"
        },
        "unit_worst_outer_fold_recall": {
          "$ref": "#/$defs/gate_check_unit_worst_fold"
        }
      }
    },
    "gate_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all_passed",
        "checks",
        "comparison_tolerance",
        "minimum_gate_rule",
        "mtaac_retired",
        "positive_delta_rule",
        "strict_positive_recall_rule",
        "terminal_status"
      ],
      "properties": {
        "all_passed": {
          "type": "boolean"
        },
        "checks": {
          "$ref": "#/$defs/gate_checks"
        },
        "comparison_tolerance": {
          "const": 1e-12
        },
        "minimum_gate_rule": {
          "const": "observed_greater_than_or_equal_to_minimum_minus_tolerance"
        },
        "mtaac_retired": {
          "const": true
        },
        "positive_delta_rule": {
          "const": "delta_strictly_greater_than_tolerance"
        },
        "strict_positive_recall_rule": {
          "const": "recall_strictly_greater_than_tolerance"
        },
        "terminal_status": {
          "enum": [
            "advance_to_prospective_freeze",
            "mtaac_retired"
          ]
        }
      }
    },
    "group_contrast_regularizer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alternate_groupings",
        "context_emission_and_bias",
        "coordinate_scope",
        "fixed_contrast_multiplier",
        "group_contrast_formula",
        "group_contrast_gradient",
        "group_pairs",
        "naive_shared_plus_residual_parameterization",
        "pooling_weight_grid",
        "runtime_tunable_contrast_parameter",
        "start_and_transition",
        "version"
      ],
      "properties": {
        "alternate_groupings": {
          "const": false
        },
        "context_emission_and_bias": {
          "const": "rho_over_2_times_sum_of_squares"
        },
        "coordinate_scope": {
          "const": "every_corresponding_emission_feature_coefficient_and_emission_bias"
        },
        "fixed_contrast_multiplier": {
          "const": 2.0
        },
        "group_contrast_formula": {
          "const": "for_each_pair_and_coordinate_mu_equals_a_plus_b_over_2_kappa_equals_a_minus_b_over_2_penalty_equals_rho_times_mu_squared_plus_2_times_kappa_squared"
        },
        "group_contrast_gradient": {
          "const": "gradient_a_equals_rho_times_(mu_plus_2_times_kappa)_and_gradient_b_equals_rho_times_(mu_minus_2_times_kappa)"
        },
        "group_pairs": {
          "const": [
            [
              "quantity",
              "unit"
            ],
            [
              "person_name",
              "settlement_name"
            ]
          ]
        },
        "naive_shared_plus_residual_parameterization": {
          "const": false
        },
        "pooling_weight_grid": {
          "const": false
        },
        "runtime_tunable_contrast_parameter": {
          "const": false
        },
        "start_and_transition": {
          "const": "rho_over_2_times_sum_of_squares"
        },
        "version": {
          "const": "v5-fixed-orthogonal-pair-group-contrast-v1"
        }
      }
    },
    "local_features": {
      "const": [
        "position_bucket",
        "line_length_bucket",
        "reported_direction",
        "damage",
        "observation_status",
        "previous_equality",
        "next_equality",
        "line_frequency_bucket",
        "seen_before",
        "seen_after"
      ]
    },
    "mass": {
      "type": "number",
      "minimum": 0.0
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "balanced_accuracy",
        "macro_f1",
        "per_state",
        "states",
        "total_family_mass",
        "weighted_accuracy",
        "weighted_confusion_matrix",
        "worst_state_recall"
      ],
      "properties": {
        "balanced_accuracy": {
          "$ref": "#/$defs/rate"
        },
        "macro_f1": {
          "$ref": "#/$defs/rate"
        },
        "per_state": {
          "$ref": "#/$defs/per_state_metrics"
        },
        "states": {
          "$ref": "#/$defs/states"
        },
        "total_family_mass": {
          "$ref": "#/$defs/mass"
        },
        "weighted_accuracy": {
          "$ref": "#/$defs/rate"
        },
        "weighted_confusion_matrix": {
          "$ref": "#/$defs/confusion_matrix"
        },
        "worst_state_recall": {
          "$ref": "#/$defs/rate"
        }
      }
    },
    "minimum_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum",
        "observed",
        "passed"
      ],
      "properties": {
        "minimum": {
          "$ref": "#/$defs/rate"
        },
        "observed": {
          "$ref": "#/$defs/rate"
        },
        "passed": {
          "type": "boolean"
        }
      }
    },
    "model_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_count",
        "candidate_selection",
        "class_adjustment_gamma",
        "class_prior_smoothing",
        "family_weighting",
        "l2_rho",
        "likelihood",
        "optimizer",
        "parameter_count",
        "regularizer",
        "states",
        "v4_refit",
        "v5_diagnostics",
        "version"
      ],
      "properties": {
        "candidate_count": {
          "const": 1
        },
        "candidate_selection": {
          "const": "none_fixed_method"
        },
        "class_adjustment_gamma": {
          "const": 0.5
        },
        "class_prior_smoothing": {
          "const": "family_weighted_jeffreys_alpha_0.5"
        },
        "family_weighting": {
          "const": "inverse_total_clean_mild_family_tokens"
        },
        "l2_rho": {
          "const": 0.01
        },
        "likelihood": {
          "const": "exact_v4_family_weighted_first_order_linear_chain_crf_conditional_log_likelihood"
        },
        "optimizer": {
          "$ref": "#/$defs/optimizer_settings"
        },
        "parameter_count": {
          "const": "exactly_the_v4_parameter_count_with_no_shared_or_residual_parameters_added"
        },
        "regularizer": {
          "$ref": "#/$defs/group_contrast_regularizer"
        },
        "states": {
          "$ref": "#/$defs/states"
        },
        "v4_refit": {
          "const": false
        },
        "v5_diagnostics": {
          "const": "none_primary_model_only"
        },
        "version": {
          "const": "v5-fixed-group-contrast-linear-chain-crf-v1"
        }
      }
    },
    "optimizer_run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted_iterations",
        "converged",
        "final_gradient_infinity_norm",
        "final_objective",
        "termination_reason"
      ],
      "properties": {
        "accepted_iterations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "converged": {
          "const": true
        },
        "final_gradient_infinity_norm": {
          "type": "number",
          "minimum": 0.0
        },
        "final_objective": {
          "type": "number"
        },
        "termination_reason": {
          "enum": [
            "gradient_infinity_norm",
            "relative_objective_stability"
          ]
        }
      }
    },
    "optimizer_settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "armijo",
        "batch",
        "convergence",
        "curvature_pair_acceptance",
        "direction",
        "fallback",
        "history_size",
        "maximum_accepted_iterations",
        "non_descent_policy",
        "numeric_type",
        "stable_logsumexp",
        "summation"
      ],
      "properties": {
        "armijo": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "c1",
            "contraction_factor",
            "initial_step",
            "maximum_trials",
            "minimum_step"
          ],
          "properties": {
            "c1": {
              "const": 0.0001
            },
            "contraction_factor": {
              "const": 0.5
            },
            "initial_step": {
              "const": 1.0
            },
            "maximum_trials": {
              "const": 31
            },
            "minimum_step": {
              "const": 9.313225746154785e-10
            }
          }
        },
        "batch": {
          "const": "full"
        },
        "convergence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "consecutive_relative_objective_iterations",
            "gradient_infinity_norm",
            "relative_objective",
            "secondary_gradient_infinity_norm"
          ],
          "properties": {
            "consecutive_relative_objective_iterations": {
              "const": 5
            },
            "gradient_infinity_norm": {
              "const": 1e-05
            },
            "relative_objective": {
              "const": 1e-09
            },
            "secondary_gradient_infinity_norm": {
              "const": 0.001
            }
          }
        },
        "curvature_pair_acceptance": {
          "const": "s_dot_y_strictly_greater_than_1e-12_times_norm_s_times_norm_y"
        },
